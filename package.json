{
  "name": "gts-dmarc-mcp",
  "version": "1.0.0",
  "description": "GTS DMARC aggregate report ingest + MCP Server — Cloudflare Worker",
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "npx wrangler dev",
    "deploy": "npx wrangler deploy",
    "cf-typegen": "npx wrangler types",
    "db:init": "npx wrangler d1 execute gts-dmarc --remote --file=./schema.sql",
    "db:init:local": "npx wrangler d1 execute gts-dmarc --local --file=./schema.sql"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.10.4",
    "@cloudflare/workers-types": "^4.20241205.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fast-xml-parser": "^4.5.0",
    "postal-mime": "^2.4.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "wrangler": "^3.101.0"
  }
}
